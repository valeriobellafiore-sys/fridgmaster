[app]
# (str) Titolo della tua applicazione
title = Fridgmaster

# (str) Nome del pacchetto
package.name = fridgmaster

# (str) Dominio del pacchetto
package.domain = org.test

# (str) Cartella sorgente del progetto (. significa la cartella corrente)
source.dir = .

# (list) Estensioni dei file da includere
source.include_exts = py,png,jpg,kv,atlas,json

# (str) Versione
version = 0.1

# (list) Requisiti
requirements = python3,kivy

# (str) Orientamento
orientation = portrait

# (bool) Schermo intero
fullscreen = 0

# (int) API Android
android.api = 33

# (str) NDK
android.ndk = 25b

[buildozer]
log_level = 2
